# From platform.armoriq.ai -> Settings -> API Keys
ARMORIQ_API_KEY=ak_your_key_here

# From dashboard.stripe.com/test/apikeys (TEST mode key, starts with sk_test_)
STRIPE_SECRET_KEY=sk_test_your_key_here

# From aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Identifies this session in ArmorIQ's observability logs
USER_EMAIL=you@your-org.com

# The specific Agent ID from the dashboard (Required for "Needs You" holds)
AGENT_ID=your_copied_agent_id_here

# Path to the local sqlite db the seed script creates
DB_PATH=./db/refunds.db
